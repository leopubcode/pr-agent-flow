# --- GitHub ---
# There is no global GitHub token: each repository's fine-grained token lives
# in repos.json in PR_AGENT_FLOW_HOME (below), a JSON object keyed by owner/repo
# (see examples/pr-agent-flow-home/repos.json):
#   {"owner/repo": {"clone_path": "/path/to/local/clone", "token": "github_pat_..."}}
# Required. Comma-separated logins whose comments/reviews the agent acts on;
# everyone else is ignored. Never add the agent's own machine user.
ALLOWED_COMMENT_AUTHORS=leopubcode

# --- AWS (terraform output -json consumer_access_key_id / consumer_secret_access_key) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-agent-flow-events

# --- Consumer ---
# Directory holding repos.json and every file the consumer writes (agents.tsv,
# processed-ids, debug.log, consumer.log). Must exist: create it from
# examples/pr-agent-flow-home (see docs/architecture.md). Default ~/.pr-agent-flow.
# PR_AGENT_FLOW_HOME=~/.pr-agent-flow
# How to run the `sbx-start` alias; the branch is appended as the last argument.
# Default: $SHELL -ic 'sbx-start "$1"' sbx-start
# SBX_START_COMMAND=zsh -ic 'sbx-start "$1"' sbx-start
POLL_WAIT_SECONDS=20
MAX_MESSAGES_PER_POLL=10
COORDINATOR_READY_TIMEOUT_SECONDS=120
PROMPT_TIMEOUT_SECONDS=30
DELIVERY_RETENTION_DAYS=7
