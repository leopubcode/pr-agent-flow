# --- GitHub ---
GITHUB_TOKEN=ghp_REPLACE_ME

# --- AWS (terraform output -json consumer_access_key_id / consumer_secret_access_key) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-agent-flow-events

# --- Consumer ---
WORKSPACE_ROOT=~/pr-agent-flow-workspace
STATE_DB_PATH=~/.pr-agent-flow/state.db
POLL_WAIT_SECONDS=20
MAX_MESSAGES_PER_POLL=10
SESSION_READY_TIMEOUT_SECONDS=60
DELIVERY_RETENTION_DAYS=7
